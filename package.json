{
  "name": "@versatiles/svelte",
  "version": "2.3.2",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/versatiles-org/node-versatiles-svelte.git"
  },
  "scripts": {
    "bundle-worker": "tsx scripts/bundle_worker.ts",
    "build": "svelte-kit sync && npm run bundle-worker && svelte-check --tsconfig ./tsconfig.json && vite build && npm run package",
    "check-watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check": "npm run lint && npm run build && npm run test && npm run format:check",
    "dev": "svelte-kit sync && npm run bundle-worker && vite dev",
    "format": "prettier --write --log-level warn .",
    "format:check": "prettier --check .",
    "lint": "eslint --color .",
    "package": "svelte-kit sync && npm run bundle-worker && svelte-package && publint",
    "prepack": "npm run build",
    "prepublishOnly": "npm run package",
    "preview": "vite preview",
    "release": "vrt release-npm",
    "screenshots": "npx tsx ./scripts/screenshots.ts",
    "test-coverage": "vitest run --coverage",
    "test-playwright": "./scripts/test_playwright.sh",
    "test-unit": "vitest run --testTimeout 10000",
    "test": "npm run test-unit && npm run test-playwright",
    "upgrade": "vrt deps-upgrade",
    "prepare": "husky"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/maplibre-gl-worker.d.ts",
    "!dist/**/__mocks__/*",
    "!dist/**/*.test.*",
    "!dist/BBoxMap/data/*",
    "!dist/BBoxMap/helpers/*"
  ],
  "peerDependencies": {
    "svelte": "^5.45.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.1",
    "@sveltejs/package": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@turf/turf": "^7.4.0",
    "@types/node": "^26.6.5",
    "@versatiles/release-tool": "^2.20.0",
    "@vitest/coverage-v8": "^5.0.3",
    "esbuild": "^0.28.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.1",
    "geojson": "^0.5.0",
    "globals": "^17.13.0",
    "happy-dom": "^21.0.1",
    "husky": "^9.1.7",
    "playwright": "^1.64.0",
    "prettier": "^3.9.10",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.25",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "dependencies": {
    "@versatiles/style": "^6.4.0",
    "maplibre-gl": "6.14.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true
  }
}

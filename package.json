{
  "name": "@versatiles/svelte",
  "version": "2.2.2",
  "license": "MIT",
  "scripts": {
    "build": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && vite build && npm run package",
    "check-watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check": "npm run lint && npm run build && npm run test && npm run format:check",
    "dev": "vite dev",
    "format": "prettier --write --log-level warn .",
    "format:check": "prettier --check .",
    "lint": "eslint --color .",
    "package": "svelte-kit sync && svelte-package && publint",
    "prepack": "npm run build",
    "prepublishOnly": "npm run package",
    "preview": "vite preview",
    "release": "vrt release-npm",
    "screenshots": "npx tsx ./scripts/screenshots.ts",
    "test-coverage": "vitest run --coverage",
    "test-playwright": "./scripts/test_playwright.sh",
    "test-unit": "vitest run --testTimeout 10000",
    "test": "npm run test-unit && npm run test-playwright",
    "upgrade": "vrt deps-upgrade",
    "prepare": "husky"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "svelte": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "!dist/**/*.spec.*",
    "!dist/**/__mocks__/*",
    "!dist/**/*.test.*",
    "!dist/BBoxMap/data/*",
    "!dist/BBoxMap/helpers/*"
  ],
  "peerDependencies": {
    "svelte": "^5.45.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/package": "^2.5.8",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@turf/turf": "^7.4.0",
    "@types/node": "^26.2.0",
    "@versatiles/release-tool": "^2.9.0",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^10.8.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "geojson": "^0.5.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.2",
    "husky": "^9.1.7",
    "playwright": "^1.62.1",
    "prettier": "^3.9.6",
    "prettier-plugin-svelte": "^4.1.1",
    "publint": "^0.3.23",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.5",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "svelte": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "type": "module",
  "dependencies": {
    "@versatiles/style": "^5.13.0",
    "maplibre-gl": "^6.2.0"
  },
  "overrides": {
    "cookie": "^0.7.0"
  },
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "fsevents": true
  }
}
